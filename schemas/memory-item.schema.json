{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amission.si/schemas/memory-item/v1",
  "title": "Mission memory item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "type",
    "title",
    "body",
    "fields",
    "tags",
    "links",
    "sensitivity",
    "confidence",
    "source",
    "createdAt",
    "updatedAt",
    "validFrom",
    "validUntil",
    "version",
    "provenance"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "domain": {
      "enum": [
        "identity",
        "work",
        "projects",
        "health",
        "fitness",
        "routines",
        "people",
        "home",
        "finance",
        "learning",
        "preferences",
        "goals",
        "sensitive"
      ]
    },
    "type": {
      "enum": [
        "fact",
        "preference",
        "goal",
        "commitment",
        "routine",
        "event",
        "person",
        "place",
        "note",
        "document-ref",
        "health-observation",
        "metric"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "body": { "type": "string", "maxLength": 32000 },
    "fields": { "type": "object" },
    "tags": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "links": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "relation"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "relation": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "sensitivity": { "enum": ["public", "personal", "private", "sensitive"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "reference": { "type": "string", "maxLength": 512 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "validFrom": { "type": ["string", "null"], "format": "date-time" },
    "validUntil": { "type": ["string", "null"], "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "at"],
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "commitment" } } },
      "then": {
        "properties": {
          "fields": {
            "required": ["dueAt", "status"],
            "properties": {
              "dueAt": { "type": "string", "format": "date-time" },
              "status": { "enum": ["open", "done", "cancelled"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "routine" } } },
      "then": {
        "properties": {
          "fields": {
            "required": ["cadenceDays", "lastCompletedAt"],
            "properties": {
              "cadenceDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365
              },
              "lastCompletedAt": {
                "type": ["string", "null"],
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "metric" } } },
      "then": {
        "properties": {
          "fields": {
            "required": ["value", "unit", "observedAt"],
            "properties": {
              "value": { "type": "number" },
              "unit": { "type": "string", "minLength": 1 },
              "observedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  ]
}
