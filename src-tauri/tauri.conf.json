{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mission Core",
  "version": "0.1.0",
  "identifier": "si.amission.core",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "title": "Mission",
        "width": 1320,
        "height": 900,
        "minWidth": 760,
        "minHeight": 620,
        "incognito": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false }
}
